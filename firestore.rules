rules_version = '2';

// LEXDEN NOVA — Firestore security rules
//
// isAdmin() must match ADMIN_EMAIL in index.html exactly. The admin only
// gets write access here once they've actually signed in to Firebase
// Authentication with THIS email (the local Admin Portal login screen is
// a separate, first-line gate in the app itself — this is the real,
// server-side enforcement that can't be bypassed by editing the page).
//
// IMPORTANT (manual step, one-time): create a user with this exact email
// and the matching password in Firebase Console → Build → Authentication
// → Users → Add user. There is no public sign-up for this account.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ruthanselem2@gmail.com';
    }

    // ---- Catalog: products, categories, shared settings (feed, content,
    // services, FAQs, etc.) — everyone can read, only the admin can write.
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reviews — any visitor can submit one; only admin can delete.
    // The client sets rating/text/date; nothing here needs to be secret.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ---- Wishlists — each shopper can only read/write their own doc,
    // keyed by their Firebase Auth uid (anonymous or signed-in).
    match /wishlists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Orders — created by the verified-payment serverless function
    // only (never trust the browser to say "paid"); a shopper may only
    // read their own orders, admin can read all.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if false; // written only by /api/verify-paystack using the Admin SDK, which bypasses these rules
      allow update, delete: if isAdmin();
    }

    // ---- Contact form messages ("leads") — anyone can send one, but
    // only the admin can read/list or delete them (Admin → Messages tab).
    match /leads/{leadId} {
      allow create: if true;
      allow read, list, delete: if isAdmin();
      allow update: if false;
    }

    // ---- Push-notification device tokens — a device registers its own
    // token (write-only from the client; no reason a shopper needs to
    // read the list of tokens). The Cloud Function reads/writes these
    // using the Admin SDK, which bypasses these rules entirely.
    match /fcmTokens/{token} {
      allow create, update: if true;
      allow read, list, delete: if isAdmin();
    }

    // ---- Feed-post notification triggers — written only by the admin
    // when they mark a new post "Important"; the Cloud Function (Admin
    // SDK) reads these regardless of these rules.
    match /feedNotify/{postId} {
      allow write: if isAdmin();
      allow read, list: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
