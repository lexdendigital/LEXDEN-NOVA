rules_version = '2';

// LEXDEN NOVA — Firestore security rules
//
// Admin identity: ruthanselem2@gmail.com is the exact email of the Firebase
// Authentication user for the admin dashboard (Firebase console →
// Authentication → Users). This is the ONLY identity allowed to write to
// the catalog/settings/products/categories, exactly as referenced in the
// app's own code comments (see explainCloudError() in index.html). If this
// account is ever recreated or changed, update the literal email in both
// isAdmin() below and ADMIN_EMAIL in index.html — they must match exactly.
//
// Orders are intentionally NOT writable by any client at all — they are
// only ever written by the /api/verify-paystack serverless function using
// the Firebase Admin SDK, which bypasses these rules entirely. That is by
// design: it is the one thing standing between "I clicked pay" and "an
// order actually exists," so no client, authenticated or not, should be
// able to create one directly.

function isAdmin() {
  return request.auth != null && request.auth.token.email == 'ruthanselem2@gmail.com';
}

// PHASE 1 SECURITY: field-level validation for the three "anyone can
// create" collections. The UI form already enforces sane input, but that
// means nothing against someone calling the Firestore SDK directly with
// the app's public config (visible in the client bundle) and skipping the
// form entirely — these checks are the actual backstop, enforced at the
// rules layer regardless of what wrote the document.
function isValidReview() {
  let d = request.resource.data;
  return d.rating is int && d.rating >= 1 && d.rating <= 5
      && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 200
      && d.name is string && d.name.size() > 0 && d.name.size() <= 1000
      && d.text is string && d.text.size() <= 1000;
}
function isValidLead() {
  let d = request.resource.data;
  return d.name is string && d.name.size() <= 1000
      && d.email is string && d.email.size() <= 1000
      && d.message is string && d.message.size() <= 1000;
}
function isValidClick() {
  let d = request.resource.data;
  return d.productId is string && d.productId.size() > 0 && d.productId.size() <= 200;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog — everyone can read (so the storefront works for
    // signed-out visitors), only the admin can write.
    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — anyone can read, and anyone can submit ONE new review
    // document (create only — no editing/deleting someone else's review).
    // The admin can delete (moderation).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Wishlists — a signed-in user (including anonymous sessions) can
    // only read/write their own wishlist document, keyed by their uid.
    match /wishlists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shopper profiles ('users' collection) — distinct from the admin
    // account. A shopper can read/write only their own profile document;
    // the admin can read all of them (e.g. for support).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Orders — written ONLY by the verify-paystack serverless function via
    // the Admin SDK (which ignores these rules). Clients may only ever
    // read their own orders; no client write path exists at all.
    match /orders/{orderId} {
      allow read: if request.auth != null &&
                     (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Leads (contact-style form submissions) — anyone can create one,
    // only the admin can read the list back.
    match /leads/{leadId} {
      allow create: if isValidLead();
      allow read, update, delete: if isAdmin();
    }

    // Product click tracking — anyone can create an event, only the
    // admin can read the analytics back.
    match /clicks/{clickId} {
      allow create: if isValidClick();
      allow read, update, delete: if isAdmin();
    }
  }
}
