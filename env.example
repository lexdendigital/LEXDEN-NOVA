PAYSTACK_SECRET_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

BREVO_TPL_WELCOME=
BREVO_TPL_VERIFY=
BREVO_TPL_RESET=
BREVO_TPL_CONTACT=
BREVO_TPL_ORDER=
BREVO_TPL_ORDER_UPDATE=
BREVO_TPL_SECURITY=
BREVO_TPL_ADMIN=
BREVO_TPL_NEWSLETTER=

CJ_API_KEY=
CJ_EMAIL=
CJ_WEBHOOK_SECRET=

OTP_SIGNING_SECRET=

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=

ADMIN_NOTIFY_EMAIL=

# Optional — only needed if your GitHub Pages / custom frontend domain(s)
# aren't already covered by the defaults in server.js (lexdendigital.github.io,
# any *.github.io, any *.onrender.com, localhost). Comma-separated.
CORS_ALLOWED_ORIGINS=

# ---- MCP (Claude custom connector) — see MCP-SETUP.md ----
# The exact public URL of THIS Render service (no trailing slash). Must be
# correct — it's baked into OAuth metadata and redirect validation.
MCP_BASE_URL=https://lexden-nova.onrender.com
# Optional: comma-separated extra allowed OAuth redirect_uris, beyond
# Claude's own (https://claude.ai/api/mcp/auth_callback and
# https://claude.com/api/mcp/auth_callback, which are always allowed).
MCP_EXTRA_REDIRECT_URIS=
# Only needed for nova_read_source_file / nova_replace_in_source_file /
# nova_write_source_file (code troubleshooting + editing via MCP).
# Format "owner/repo", e.g. "lexdendigital/LEXDEN-NOVA".
GITHUB_REPO=
# A GitHub Personal Access Token. Reading a PUBLIC repo's files works
# without this at all; writing/committing a change requires a token with
# "repo" (or fine-grained "Contents: read and write") scope.
GITHUB_TOKEN=
